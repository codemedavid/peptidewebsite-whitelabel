{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.pepweb.store",
        "EXPO_PUBLIC_ROOT_DOMAIN": "pepweb.store",
        "EXPO_PUBLIC_SUPPORT_URL": "https://pepweb.store"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
