// Multi-tenant peptide SaaS — shared schema, row-level tenancy.
// One DB. tenant_id is the leading column of every tenant-scoped index.
// RLS policies (see prisma/rls.sql) are the defense-in-depth backstop.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooled connection
  directUrl = env("DIRECT_URL") // for migrations
}

// ──────────────────────────── Tenancy & plans ────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active") // active | suspended | trial
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id])
  createdAt DateTime @default(now())

  // Per-tenant order-number format: { prefix, separator, scheme: 'random'|'sequential', digits }.
  orderNumberFormat Json @default("{}")
  // Monotonic counter for scheme=sequential. Atomically incremented per order (see lib/orders/order-number.ts).
  orderSeq          Int  @default(1000)

  // Password-only tenant admin login (slug.<root>/admin). Hash is scrypt-derived
  // ("scrypt$<salt-hex>$<hash-hex>"). Null = password not yet set by the platform owner.
  adminPasswordHash String?

  // Visitor access-code gate (per-tenant "enter a code to view the store").
  // Hash is scrypt-derived, same format as adminPasswordHash. Null = no gate set
  // (the storefront is open). The gate is only enforced when this is non-null AND
  // branding.config.accessGate.enabled is true. Bumping accessCodeVersion (done on
  // every code rotation) is what instantly invalidates all live visitor cookies:
  // a cookie carries the version it was minted under and is rejected once it drifts.
  accessCodeHash    String?
  accessCodeVersion Int     @default(1)

  // Super-admin quick-contact: the tenant owner's WhatsApp as a bare dial string
  // (digits only, see lib/admin/whatsapp.ts). Operator-set, not tenant-editable.
  // Null = not connected. Powers the one-tap "Message on WhatsApp" link in the
  // platform tenants console.
  ownerWhatsapp     String?

  // Paid subscription window (operator-set, not tenant-editable) that powers the
  // subscription-duration banner in the store admin + the window row in the
  // platform tenant detail. Governs a PAID tenant only (status != "trial" — trial
  // tenants show the trial banner from OnboardingSubmission instead). Resolved
  // through lib/subscription/subscription-state.ts (pure math, test:subscription-state)
  // and lib/subscription/subscription-info.ts (cached read). Both null = no window,
  // so no banner renders and legacy tenants stay byte-identical.
  subscriptionStartsAt DateTime?
  subscriptionEndsAt   DateTime?
  // Billing cycle the operator chose for this window: monthly | quarterly |
  // semi_annual | yearly (string-enum, see lib/subscription/billing-cycle.ts).
  // Drives the auto-calculated due date in the tenant-detail setter and the
  // "Type" row shown in the tenant details. Null = no window / legacy tenant.
  // Purely descriptive — the countdown math reads the concrete start/end dates,
  // so this never has to agree with the exact day span (an overridden due date
  // keeps its stored cycle label).
  subscriptionCycle    String?
  // What the tenant actually paid for the current subscription term, in centavos
  // (e.g. a yearly plan billed at ₱15,000 → 1500000). Operator-set alongside the
  // window; null = not recorded. Shown as "Amount paid" in the tenant detail.
  subscriptionAmountCents Int?
  // The tenant's recurring MONTHLY price ("Monthly price due" in the Subscription
  // window setter), in centavos — the per-month rate, NOT the per-term total, so
  // it feeds monthly MRR directly the same way the plan-config monthly price does.
  // Operator-set and per-tenant, distinct from subscriptionAmountCents (an actual
  // past per-term payment). When set it overrides the plan-config monthly price
  // for this tenant's Plan-fee display + MRR (effectivePlanFeeCents); null = plan.
  subscriptionPriceCents Int?

  domains           Domain[]
  groupBuys         GroupBuy[]
  authAudits        AuthAudit[]
  integrations      TenantIntegration[]
  featureOverrides  TenantFeatureOverride[]
  contacts          Contact[]
  products          Product[]
  carts             Cart[]
  orders            Order[]
  storefrontOrders  StorefrontOrder[]
  events            Event[]
  emailLogs         EmailLog[]
  automationRuns    AutomationRun[]
  automationMetrics AutomationMetric[]

  // ── Storefront / white-label layer (added) ──
  members  TenantUser[]
  staff    StorefrontStaff[]
  branding Branding?
  settings TenantSettings?
  pages    Page[]
  blogs    BlogPost[]
  coupons  Coupon[]
  media    MediaAsset[]

  // Self-serve onboarding submissions that provisioned (or will provision) this tenant.
  onboardingSubmissions OnboardingSubmission[]
  upgradeRequests       UpgradeRequest[]

  // Proof-of-payment ledger the tenant submits against their subscription term;
  // the operator confirms/rejects each on the platform Billing tab.
  subscriptionPayments  SubscriptionPayment[]

  @@index([planId])
  @@map("tenants")
}

// One tenant-submitted proof-of-payment for a subscription term. The tenant
// uploads a payment screenshot + reference from the store admin's Billing view;
// the platform operator reviews it (confirm | reject) on the tenant-detail
// Billing tab. Confirmed rows are the platform's realized subscription revenue
// from this tenant — the Billing page's lifetime metrics roll up from them
// (lib/subscription/payments.ts, test:subscription-payments). Separate from the
// operator-set subscription *window* on Tenant: the window says when a term is
// due, this ledger records what was actually paid against it.
model SubscriptionPayment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // What the tenant says they paid, in centavos (₱1,499.00 → 149900).
  amountCents Int
  // Billing cycle the payment covers (snapshot of Tenant.subscriptionCycle at
  // submit time): monthly | quarterly | semi_annual | yearly. Null = unspecified.
  cycle       String?
  // The billing term this payment is for (snapshot of the window). Both null for
  // an ad-hoc payment not tied to a resolved window.
  periodStart DateTime?
  periodEnd   DateTime?

  // How the tenant paid + their reference number (normalizePaymentMethod keeps
  // method to a known set: GCash | Maya | Bank transfer | Card | Other).
  method    String @default("Other")
  reference String @default("")
  // ImageKit-hosted proof screenshot (never a data URL in production). Null =
  // none uploaded (submission still allowed; operator reviews on trust).
  proofUrl  String?
  // When the tenant says the payment was made (their receipt time), distinct
  // from submittedAt (when they filed it here).
  paidAt    DateTime?

  // pending | confirmed | failed (lib/subscription/payments.ts owns the
  // transitions). Confirmed = counted as revenue; failed = operator-rejected.
  status     String    @default("pending")
  reviewedAt DateTime?
  reviewNote String    @default("")

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, submittedAt])
  @@map("subscription_payments")
}

model Domain {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostname  String  @unique // store.acme.com | acme.peptide.app
  verified  Boolean @default(false)
  isPrimary Boolean @default(false)

  @@index([tenantId])
  @@map("domains")
}

model Plan {
  id       String        @id @default(cuid())
  key      String        @unique // basic | ecommerce | growth
  name     String
  tenants  Tenant[]
  features PlanFeature[]

  @@map("plans")
}

model Feature {
  id              String                  @id @default(cuid())
  key             String                  @unique // matches FEATURES catalog, e.g. automation.abandoned_cart
  description     String?
  plans           PlanFeature[]
  tenantOverrides TenantFeatureOverride[]

  @@map("features")
}

model PlanFeature {
  planId    String
  featureId String
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

// Per-tenant grant/revoke on top of the plan (trials, custom deals, beta access).
model TenantFeatureOverride {
  tenantId  String
  featureId String
  enabled   Boolean
  expiresAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature   Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([tenantId, featureId])
  @@map("tenant_feature_overrides")
}

// ──────────────────────────── Integrations ────────────────────────────

model TenantIntegration {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider String // posthog | stripe | resend | mailgun | sendgrid
  enabled  Boolean @default(false) // the on/off toggle — never deletes creds

  // Envelope-encrypted credential blob: { ciphertext, iv, tag }. Never store plaintext.
  encryptedCredentials Json
  dataKeyId            String // which wrapped data key (DEK) encrypted this
  config               Json   @default("{}") // non-secret config (host, from-address, ...)

  lastHealthCheckAt DateTime?
  healthOk          Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("tenant_integrations")
}

// ──────────────────────────── People & commerce ────────────────────────────

model Contact {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  distinctId   String // analytics identity (anon or user id)
  email        String?
  unsubscribed Boolean  @default(false)
  traits       Json     @default("{}")
  createdAt    DateTime @default(now())

  carts     Cart[]
  orders    Order[]
  emailLogs EmailLog[]

  @@unique([tenantId, distinctId])
  @@index([tenantId, email])
  @@map("contacts")
}

model Product {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku        String
  name       String
  priceCents Int
  currency   String  @default("USD")
  active     Boolean @default(true)

  // ── Storefront fields (added) ──
  slug        String? // unique per tenant → /products/[slug]
  description String?
  images      Json     @default("[]") // ImageKit ids/urls
  stock       Int      @default(0)
  status      String   @default("active") // draft | active | archived
  metadata    Json     @default("{}") // peptide compliance: purity %, COA url, research-use-only
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@index([tenantId, active])
  @@index([tenantId, status])
  @@map("products")
}

model Cart {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?   @relation(fields: [contactId], references: [id])
  distinctId String
  status     String     @default("open") // open | converted | abandoned
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([tenantId, distinctId, status])
  @@map("carts")
}

model CartItem {
  id         String  @id @default(cuid())
  cartId     String
  cart       Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int     @default(1)
  priceCents Int

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                    String      @id @default(cuid())
  tenantId              String
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId             String?
  contact               Contact?    @relation(fields: [contactId], references: [id])
  distinctId            String
  orderNumber           String // tenant-facing formatted code, e.g. ABC-1001 (see lib/orders/order-number.ts)
  status                String      @default("paid") // paid | fulfilled | refunded
  totalCents            Int
  currency              String      @default("USD")
  stripePaymentIntentId String?
  items                 OrderItem[]
  createdAt             DateTime    @default(now())

  @@unique([tenantId, orderNumber])
  @@index([tenantId, createdAt])
  @@index([tenantId, distinctId])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  priceCents Int

  @@index([orderId])
  @@map("order_items")
}

// Manual-checkout storefront orders — the DB home for the rich order the
// storefront builds at checkout (customer + shipping + items + proof of
// payment). Kept separate from the Stripe/analytics `Order` above, which is
// keyed to totals/payment-intents and feeds the platform revenue dashboards;
// mixing the two enums/shapes would corrupt those aggregates. Proof of payment
// is hosted on ImageKit (paymentProofUrl) — never stored as a base64 data URL.
model StorefrontOrder {
  id              String  @id @default(cuid())
  tenantId        String
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber     String // tenant-facing formatted code, e.g. ABC-1001
  // Client-supplied idempotency key (the checkout draft id). Lets a retry after a
  // lost/timed-out response return the already-stored order instead of creating a
  // duplicate. Nullable so legacy rows (and any non-idempotent caller) are exempt;
  // NULLs are distinct in Postgres, so multiple null-key rows are allowed.
  clientId        String?
  status          String  @default("new") // new | confirmed | processing | shipped | delivered | cancelled
  paymentStatus   String  @default("pending") // pending | paid
  paymentMethod   String  @default("")
  paymentProofUrl String? // ImageKit-hosted proof of payment (never a data URL)

  // Denormalized blobs — the storefront Order type's nested objects.
  customer Json @default("{}") // { name, email, phone, contactMethod }
  shipping Json @default("{}") // { address, barangay, city, province, postal, country, region, fee }
  items    Json @default("[]") // [{ name, qty, price }]
  // Admin/service fee charged on this order — { label, amount }, snapshotted
  // server-side at placement from branding.config.adminFee so changing the
  // tenant's fee never rewrites existing orders. NULL = no fee was charged.
  adminFee Json?
  // Discount code applied to this order — { code, label, amount }, snapshotted
  // server-side at placement from branding.config.promoCodes (re-derived, never
  // trusted from the client) so the saved amount can't be inflated and a later
  // code edit never rewrites existing orders. It REDUCES the total. NULL = no
  // code was applied.
  discount Json?
  // Append-only fulfillment journey: one entry per status transition, oldest
  // first, e.g. [{ status: "new", at }, { status: "confirmed", at }, …]. Drives
  // the storefront Track page's timeline. Seeded with the "new" event at create.
  statusHistory Json @default("[]")

  courier        String   @default("")
  trackingNumber String   @default("")
  shippingNote   String   @default("")
  placedAt       DateTime @default(now()) // the storefront-facing order date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  // Group-buy attribution — stamped SERVER-SIDE at placement from the group buy
  // that was live (and covering the ordered products) at checkout. The name is
  // snapshotted alongside the id so supplier reports survive later renames.
  // NULL = placed outside any group buy (or the module was off).
  groupBuyId   String?
  groupBuyName String?

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, clientId]) // idempotency: one stored order per checkout draft
  @@index([tenantId, createdAt])
  @@index([tenantId, groupBuyId])
  @@map("storefront_orders")
}

// A buying window the store owner opens for customers to order together —
// orders placed while it is live are attributed to it (StorefrontOrder.groupBuyId)
// so the owner can aggregate quantities into one supplier order. Managed from the
// store admin's "Group Buys" view; every capability is feature-gated (groupbuy.*).
model GroupBuy {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  status      String    @default("draft") // draft | scheduled | active | closed | archived
  startsAt    DateTime? // scheduled window — goes live at startsAt (groupbuy.scheduled)
  endsAt      DateTime? // closes automatically once endsAt passes
  deliveryEta String    @default("") // customer-facing ETA, e.g. "3–4 weeks after close"
  // Product ids assigned to this group buy (groupbuy.product_assignment).
  // Empty array = the group buy covers the whole catalog.
  productIds  Json      @default("[]")
  // Storefront slot-goal for the progress bar ("18 of 30 slots filled"). 0 = the
  // goal is off and no bar renders — set/cleared per round by the store owner.
  slotGoal    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([tenantId, status])
  @@map("group_buys")
}

// Auth audit trail — security-relevant events on the access gate / tenant admin.
// Written server-side only (best-effort; see lib/auth/audit.ts). event is one of
// code_rotated | admin_login | admin_login_failed.
model AuthAudit {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event     String
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("auth_audit")
}

// ──────────────────────────── Events, email, automation ────────────────────────────

// Outbox + audit trail. Source of truth for replay/reconciliation.
model Event {
  id         String   @id // ULID (time-sortable)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  distinctId String
  name       String // matches EVENTS catalog, e.g. cart_item_added
  props      Json     @default("{}")
  ts         DateTime @default(now())

  // outbox dispatch tracking
  analyticsSent  Boolean @default(false)
  automationSent Boolean @default(false)

  @@index([tenantId, name, ts])
  @@index([tenantId, distinctId, ts])
  @@map("events")
}

model EmailLog {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact? @relation(fields: [contactId], references: [id])
  provider          String // resend | sendgrid | mailgun
  providerMessageId String?  @unique // dedupe / open-click correlation
  template          String
  flow              String? // abandoned_cart | welcome | reorder | dunning
  status            String   @default("sent") // sent | delivered | opened | clicked | bounced | failed
  idempotencyKey    String?  @unique
  createdAt         DateTime @default(now())

  @@index([tenantId, flow, createdAt])
  @@map("email_logs")
}

// Tracks the state of a journey/workflow instance (mirrors Inngest run for in-app visibility).
model AutomationRun {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  functionId   String // abandoned-cart | welcome | reorder | win-back
  distinctId   String
  status       String    @default("running") // running | completed | cancelled | failed | skipped
  inngestRunId String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([tenantId, functionId, status])
  @@map("automation_runs")
}

// Pre-aggregated KPIs so the dashboard never recomputes from raw events.
model AutomationMetric {
  id                    String @id @default(cuid())
  tenantId              String
  tenant                Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period                String // e.g. 2026-05 or 2026-05-26
  emailsSent            Int    @default(0)
  cartsRecovered        Int    @default(0)
  revenueRecoveredCents Int    @default(0)

  @@unique([tenantId, period])
  @@map("automation_metrics")
}

// ──────────────────────────── Auth & roles (RBAC) ────────────────────────────
// Supabase Auth issues identity (auth.users.id). Authorization lives here.

// Global platform operators (you + your team). role: super_admin | support
model PlatformUser {
  id        String   @id // = Supabase auth.users.id
  email     String   @unique
  role      String   @default("super_admin")
  createdAt DateTime @default(now())

  @@map("platform_users")
}

// Tenant membership. One auth user can belong to many tenants.
// role: owner | tenant_admin | staff
model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String // = Supabase auth.users.id
  email     String
  role      String   @default("staff")
  createdAt DateTime @default(now())

  @@unique([tenantId, userId]) // one membership per user per tenant
  @@index([userId]) // "which tenants does this user belong to?"
  @@map("tenant_users")
}

// ──────────────────────────── Branding / theming ────────────────────────────

model Branding {
  id         String  @id @default(cuid())
  tenantId   String  @unique
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoUrl    String?
  faviconUrl String?
  themeId    String  @default("default") // preset key
  colors     Json    @default("{}") // { primary, secondary, accent, background, foreground, ... }
  fonts      Json    @default("{}") // { heading, body }
  config     Json    @default("{}") // full storefront Brand config (sections, pages, hero/catalog copy, footer, admin) — see storefront/types Brand
  radius     String  @default("0.5rem")
  customCss  String?

  @@map("branding")
}

model TenantSettings {
  id           String  @id @default(cuid())
  tenantId     String  @unique
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeName    String?
  supportEmail String?
  currency     String  @default("USD")
  compliance   Json    @default("{}") // age gate, research-use-only, region blocks
  navigation   Json    @default("{}")
  footer       Json    @default("{}")

  @@map("tenant_settings")
}

// ──────────────────────────── CMS: pages, blog, coupons, media ────────────────────────────

// Page = ordered, typed sections rendered by the modular section builder.
model Page {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  sections  Json     @default("[]") // [{ type: "hero", props: {...} }, ...]
  status    String   @default("draft") // draft | published | archived
  seo       Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("pages")
}

model BlogPost {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  body        Json      @default("{}")
  coverUrl    String?
  status      String    @default("draft") // draft | published | archived
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
  @@map("blog_posts")
}

// Storefront discount codes (backs the ecommerce.discounts feature).
model Coupon {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code           String
  percentOff     Int?
  amountOffCents Int?
  active         Boolean   @default(true)
  expiresAt      DateTime?

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("coupons")
}

// ImageKit-backed media library per tenant (logos, product images, blog covers).
model MediaAsset {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imagekitId String
  url        String
  type       String
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@map("media_assets")
}

// ──────────────────────────── Self-serve onboarding ────────────────────────────
// One row per public sign-up from jonina.store/get-started. Captures all 7
// onboarding steps and the proof of payment, then auto-provisions a Tenant
// (status "pending_setup") whose id is linked back here. The Super Admin works
// the submission through setupStatus until the store is published.
//
// PLATFORM-LEVEL — deliberately RLS-excluded (see prisma/rls.sql): written by an
// unauthenticated public action (no tenant GUC) and read only by the operator.
model OnboardingSubmission {
  id String @id @default(cuid())

  // Step 1 — business information
  businessName  String
  businessType  String  @default("")
  description   String?
  contactPerson String?
  email         String
  whatsapp      String?
  facebook      String?

  // Step 2 — branding & design
  themeStyle       String? // minimal | luxury | ecommerce | dark | custom
  themeId          String  @default("clinical-white")
  primaryColor     String?
  secondaryColor   String?
  logoUrl          String?
  bannerUrls       Json    @default("[]")
  inspirationUrls  Json    @default("[]")
  inspirationNotes String?

  // Step 3 — products: [{ name, price, description, category, imageUrl }]
  products Json @default("[]")

  // Step 4 — order destination
  orderDestination      String? // whatsapp | messenger | telegram | email
  orderDestinationValue String?

  // Step 5 — payment methods: [{ name, account, number, qrUrl, instructions }]
  paymentMethods Json @default("[]")

  // Step 6 — package (DB plan key: starter | pro | enterprise)
  packageKey String @default("starter")

  // Step 6 — billing cycle the sign-up prepaid: monthly | yearly
  // (lib/onboarding/schema.ts ONBOARDING_BILLING_CYCLES). Drives amountDueCents
  // and seeds the tenant's subscriptionCycle. Rows predating it read "monthly".
  billingCycle String @default("monthly")

  // Step 6 — signed up on the ₱699 1-month Business trial (pro only)
  trial Boolean @default(false)
  // Operator-managed trial window (Super Admin → Onboarding → Package stat)
  trialStartsAt DateTime?
  trialEndsAt   DateTime?

  // Step 6 — Starter add-on features the client picked: string[] of
  // track | faq | calculator | protocols | coa (empty for other tiers)
  selectedFeatures Json @default("[]")

  // Step 7 — checkout
  paymentProofUrl String?
  termsAccepted   Boolean @default(false)
  // Server-computed total the client was asked to pay (centavos): first payment
  // + Starter extras + setup fee — see lib/onboarding/pricing.amountDueFromConfig.
  // Null on submissions predating the stamp.
  amountDueCents Int?

  // ── Automation / operator workflow ──
  slug        String // generated subdomain label
  tenantId    String? // linked tenant once provisioned
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  // payment_received | tenant_created | customizing | revision | completed
  setupStatus String  @default("payment_received")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([setupStatus])
  @@index([tenantId])
  @@index([createdAt])
  @@map("onboarding_submissions")
}

// ──────────────────────────── Platform settings ────────────────────────────
// Key/value store for operator-managed platform-wide configuration (e.g. the
// "package_payment" receiving details shown on the public /get-started checkout).
//
// PLATFORM-LEVEL — deliberately RLS-excluded (see prisma/rls.sql): no tenantId;
// written only by the Super Admin and read by the public marketing pages
// (server-side, privileged connection, outside withTenant).
model PlatformSetting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt

  @@map("platform_settings")
}

// ──────────────────────────── Store-admin staff ────────────────────────────
// Per-tenant staff sub-accounts for the storefront admin (slug.<root>/#admin).
// The store OWNER creates these; each staff member signs in with their own
// username + password (scrypt hash, same `scrypt$<salt>$<hash>` format as
// adminPasswordHash) and sees only the admin modules granted in `permissions`
// (string[] of keys from storefront/admin/staff-permissions.ts). Suspending a
// row blocks login immediately because the session guard re-loads it on every
// request. SERVER-ONLY: unlike branding.config it is never shipped to the
// client, so staff credentials cannot leak to the browser.
model StorefrontStaff {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  username     String
  passwordHash String // scrypt$<salt-hex>$<hash-hex>
  status       String   @default("active") // active | suspended
  permissions  Json     @default("[]") // string[] of staff-permission module keys
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([tenantId, username]) // one username per store; also the scoped lookup key
  @@index([tenantId])
  @@map("storefront_staff")
}

// Store-owner upgrade submission (trial system): filed from the in-admin
// Upgrade page with a proof-of-payment upload, decided by the platform
// operator (Super Admin → Upgrades). Approval flips Tenant.planId to the
// Business plan and reactivates the storefront; decisions are final
// (lib/trial/upgrade-request.ts state machine, test:trial-upgrade).
model UpgradeRequest {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fromPlan String // plan key at request time (audit)
  toPlan   String @default("pro")
  // pending | approved | rejected
  status String @default("pending")

  // Server-stamped order summary at request time (PHP centavos)
  amountCents Int @default(0)
  creditCents Int @default(0)

  payMethod String? // the receiving method the owner said they paid with
  proofUrl  String? // proof-of-payment image (ImageKit)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId])
  @@index([status])
}
