{
  "name": "peptide-whitelabel-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:owner": "tsx prisma/seed-owner.ts",
    "db:sync-features": "tsx scripts/sync-plan-features.ts",
    "db:roles": "prisma db execute --file prisma/roles.sql --schema prisma/schema.prisma",
    "db:rls": "prisma db execute --file prisma/rls.sql --schema prisma/schema.prisma",
    "db:rls:check": "tsx prisma/rls-check.ts",
    "test:isolation": "tsx scripts/test-isolation.ts",
    "test:themes": "tsx scripts/check-theme-contrast.ts",
    "test:gate": "tsx scripts/test-access-gate.ts",
    "test:posthog": "tsx scripts/test-posthog.ts",
    "test:plan-status": "tsx scripts/test-plan-options.ts",
    "test:staff": "tsx scripts/test-staff-permissions.ts",
    "test:cart": "tsx scripts/test-cart-pricing.ts",
    "test:plan-scope": "tsx scripts/test-plan-scope.ts",
    "test:plan-distribution": "tsx scripts/test-plan-distribution.ts",
    "test:admin-whatsapp": "tsx scripts/test-admin-whatsapp.ts",
    "test:feature-disclosure": "tsx scripts/test-feature-disclosure.ts",
    "test:order-detail": "tsx scripts/test-order-detail.ts",
    "test:bulk-order-status": "tsx scripts/test-bulk-order-status.ts",
    "test:payment-proof-viewer": "tsx scripts/test-payment-proof-viewer.ts",
    "test:hero-links": "tsx scripts/test-hero-links.ts",
    "test:banner": "tsx scripts/test-banner.ts",
    "test:reviews": "tsx scripts/test-reviews-feature.ts",
    "test:protocol-images": "tsx scripts/test-protocol-images.ts",
    "test:protocol-sort": "tsx scripts/test-protocol-sort.ts",
    "test:admin-login-mode": "tsx scripts/test-admin-login-mode.ts",
    "test:admin-order-alert": "tsx scripts/test-admin-order-alert.ts",
    "test:notice-modal": "tsx scripts/test-notice-modal.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "imagekit": "^6.0.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "pglite-prisma-adapter": "^0.6.1",
    "playwright-core": "^1.60.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
